# Supabase Configuration
# Получите эти значения из вашего Supabase проекта:
# Dashboard -> Project Settings -> API

# URL вашего Supabase проекта
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Публичный ключ (anon/public key)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ID проекта Supabase
VITE_SUPABASE_PROJECT_ID=your-project-id

# ============================================
# Примечания:
# ============================================
# 1. Скопируйте этот файл в .env:
#    cp .env.example .env
#
# 2. Замените значения на реальные из вашего Supabase проекта
#
# 3. НЕ коммитьте .env в git (уже в .gitignore)
#
# 4. Для production используйте переменные окружения сервера
